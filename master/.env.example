# NexGen Master configuration. Copy to master/.env (gitignored) and fill in.

# true = answer from data/scenarios.json instead of calling the Query (8001) and RAG (8002) services
MOCK_SERVICES=true
QUERY_SERVICE_URL=http://localhost:8001
RAG_SERVICE_URL=http://localhost:8002

# LLM: any OpenAI-compatible API. Leave OPENAI_API_KEY empty to run rules-only (no LLM).
# Free option: create a key at https://console.groq.com/keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL_NAME=openai/gpt-oss-20b

# Sessions (falls back to in-memory storage if Redis is not running)
REDIS_URL=redis://localhost:6379/0
